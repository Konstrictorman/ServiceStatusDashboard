# All optional; defaults shown. Read from the process environment, e.g.
#   PORT=3200 API_URL=http://127.0.0.1:3200 npm run dev   (API_URL tells the Vite proxy where the server is)
NODE_ENV=development
HOST=0.0.0.0
PORT=3100
LOG_LEVEL=info
POLL_INTERVAL_MS=10000
CHECK_TIMEOUT_MS=2000
DEGRADED_LATENCY_MS=1000
STALE_AFTER_MS=30000
EVENT_HISTORY_LIMIT=100
