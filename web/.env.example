# Optional. Read by Vite at dev/build time (copy to .env.local, or set in the shell).
# How often the browser asks the API for fresh data, in milliseconds (1000–600000).
VITE_REFRESH_INTERVAL_MS=15000

# Where the Vite dev server forwards /api requests (dev only, not exposed to the browser).
API_URL=http://127.0.0.1:3100
